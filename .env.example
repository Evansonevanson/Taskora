# ==============================================================================
# Taskora Environment Variables Template (.env.example)
# NEVER commit real secret values to version control.
# Copy this file to .env.local for local development.
# ==============================================================================

# Supabase (Public / Client-safe)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase (Server-only — NEVER expose to client bundle)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend Email API (Server-only — NEVER expose to client bundle)
RESEND_API_KEY=re_your_resend_api_key

# Upstash Redis for Rate Limiting (Server-only)
UPSTASH_REDIS_REST_URL=https://your-upstash-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# Application URL (for email deep links and absolute callbacks)
APP_URL=http://localhost:3000
